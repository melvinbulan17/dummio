{
  "name": "dummio",
  "description": "Fill any web form with realistic fake data in one click.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "lint": "eslint",
    "typecheck": "wxt prepare && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "wxt prepare",
    "prepare": "husky",
    "data": "node scripts/build-data.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/fragment-mono": "^5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wxt-dev/module-react": "^1.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml,html}": "prettier --write"
  }
}
